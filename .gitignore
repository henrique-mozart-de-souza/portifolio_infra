# Local .terraform directories
**/.terraform/*

# .tfstate files (O Estado da infraestrutura nunca deve ir pro Git público!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignorar variáveis de teste local (se você criar um arquivo só pra testes na sua máquina)
terraform.tfvars
local.tfvars

# MAS PERMITIR os arquivos de ambiente oficiais
!environments/*.tfvars

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS generated files
.DS_Store
Thumbs.db